{
  "name": "cortico-world-terrarium",
  "version": "0.8.5",
  "type": "module",
  "description": "Claimable land and water ecosystems with plants, bugs, fish and a public leaderboard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiyuHD/cortico-world-terrarium.git"
  },
  "homepage": "https://cortico-box.zhiyuhub.top",
  "bugs": {
    "url": "https://github.com/zhiyuHD/cortico-world-terrarium/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "terrarium",
    "ecosystem",
    "simulation",
    "game"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "Terrarium",
    "tags": [
      "game"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui/0.8.5/client.js",
    "webUiStyle": "dist/webui/0.8.5/client.css",
    "locales": {
      "zh": {
        "displayName": "生态箱",
        "description": "自行认领独立的地箱和水箱，照料植物、虫子与鱼，查看环境历史和捕食回放。"
      },
      "en": {
        "displayName": "Terrarium",
        "description": "Claim independent land and water ecosystems, care for plants, bugs and fish, and inspect environmental history and hunt replays."
      }
    }
  },
  "files": [
    "src",
    "server",
    "dist/webui",
    "dist/server.mjs",
    "dist/scene.js",
    "dist/index.html",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json",
    "dist/admin.mjs",
    "dist/console",
    "dist/release.mjs",
    "dist/runner.mjs",
    "dist/migrate-flat.sh",
    "docs"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:webui": "tsc --noEmit -p tsconfig.web.json",
    "build:webui": "esbuild webui/client.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/webui/0.8.5/client.js",
    "build:server": "tsx server/build.ts",
    "build:admin": "esbuild server/admin.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/admin.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "cortico": "^0.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "author": "zhiyuxl",
  "dependencies": {
    "ws": "^8.22.0",
    "terrarium-renderer": "^0.1.0"
  }
}
